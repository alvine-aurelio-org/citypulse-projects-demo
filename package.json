{
  "name": "citypulse-projects-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One complete, fictional GitHub Projects delivery environment with exactly 50 issues and one sprint.",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test",
    "report": "node tools/render-reports.mjs",
